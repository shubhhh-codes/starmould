DATABASE_URL=postgresql://BACKUP_USER:PASSWORD@DATABASE_HOST:5432/postgres?sslmode=verify-full
# App UI flag; enable only when this environment has its own deployed worker.
BACKUP_JOBS_ENABLED=false
BACKUP_CONTROL_DATABASE_URL=
BACKUP_DUMP_DATABASE_URL=
BACKUP_DATABASE_CA=
# The supplied Docker image creates this public CA bundle at build time.
# For Windows use .backup-tools/supabase-ca.crt relative to the repository root.
BACKUP_DATABASE_CA_FILE=/app/database-ca.crt
BACKUP_PGSSLROOTCERT=/app/database-ca.crt
BACKUP_SCHEMAS=public
BACKUP_R2_ACCOUNT_ID=your-backup-r2-account-id
BACKUP_R2_BUCKET=your-private-backup-bucket
BACKUP_R2_ACCESS_KEY_ID=your-backup-r2-access-key-id
BACKUP_R2_SECRET_ACCESS_KEY=your-backup-r2-secret-access-key
BACKUP_MONITOR_SECRET=
PORT=8080
BACKUP_BIND_HOST=127.0.0.1
BACKUP_FALLBACK_ENABLED=true
