# Star Mould ERP Environment Configuration
# Copy this file to .env.local and fill in the values

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-side Administration & Service Role (Secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Session Authentication Secret (Min 32 characters HMAC SHA-256)
SESSION_SECRET=

# Direct PostgreSQL Database Connection (used by scripts/run-migrations.mjs)
DATABASE_URL=
