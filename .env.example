# Star Mould ERP Environment Configuration
# Copy this file to .env.local and fill in the values

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-side Administration & Service Role (Secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Session Authentication Secret (Min 32 characters HMAC SHA-256)
SESSION_SECRET=your-long-random-session-secret-min-32-chars

# PostgreSQL Database Connections (Used for migrations & backups)
DATABASE_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL_POOLER=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Cron / Automation Security Secret (Used to authenticate automated endpoints like /api/backup/cron)
CRON_SECRET=your-cron-secret-token
