# Star Mould ERP Environment Configuration
# Copy this file to .env.local and fill in the values

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-side Administration & Service Role (Secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Session Authentication Secret (Min 32 characters HMAC SHA-256)
SESSION_SECRET=your-long-random-session-secret-min-32-chars

# PostgreSQL Database Connections (Used for migrations & backups)
DATABASE_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL_POOLER=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Cron / Automation Security Secret (Used to authenticate automated endpoints like /api/backup/cron)
CRON_SECRET=your-cron-secret-token

# Durable database backup UI (enable after migration + independent worker deployment)
BACKUP_JOBS_ENABLED=false
# Optional coordinator connection; defaults to DATABASE_URL. Use verified TLS.
BACKUP_CONTROL_DATABASE_URL=
# Direct/session-pooler libpq URL for pg_dump; defaults to DATABASE_URL.
BACKUP_DUMP_DATABASE_URL=
BACKUP_DATABASE_CA=
# Local Windows setup: install-postgres-tools.cjs creates this public CA bundle.
# On Vercel use BACKUP_DATABASE_CA with the full Supabase PEM, not a PC file path.
BACKUP_DATABASE_CA_FILE=.backup-tools/supabase-ca.crt
BACKUP_PGSSLROOTCERT=
# Public schema includes ERP tables/functions/policies; excludes photos and global roles.
BACKUP_SCHEMAS=public
# Dedicated PRIVATE database bucket and bucket-scoped credentials, separate from photos.
BACKUP_R2_ACCOUNT_ID=your-backup-r2-account-id
BACKUP_R2_BUCKET=your-private-backup-bucket
BACKUP_R2_ACCESS_KEY_ID=your-backup-r2-access-key-id
BACKUP_R2_SECRET_ACCESS_KEY=your-backup-r2-secret-access-key
# >=32 random characters, used only by an independent uptime monitor.
BACKUP_MONITOR_SECRET=
# Independent/local worker rollout gate; enable after GitHub primary cutover.
BACKUP_FALLBACK_ENABLED=true

# Cloudflare R2 Storage (Private Bucket for Movement Photos & Backups)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=starmould-movement-photos
